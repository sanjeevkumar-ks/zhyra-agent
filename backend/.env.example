# ─── Server Settings ──────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Set DEBUG=false in production
DEBUG=false

# Frontend URL (used for CORS and OAuth redirect after callback)
# Production: https://zhyra.web.app
# Development: http://localhost:5173
FRONTEND_BASE_URL=https://zhyra.web.app

# Backend base URL (used for OAuth redirect URIs)
# Production: https://zhyra.web.app (routes through Firebase Hosting → Cloud Run)
# Development: http://localhost:8000
BACKEND_BASE_URL=https://zhyra.web.app

# ─── Security & Encryption ────────────────────────────────────────────────────
# Generate a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Auth bypass (set to false in production — use real Firebase auth)
FIREBASE_BYPASS_AUTH=false
MOCK_USER_ID=

# ─── Firebase Admin SDK Configuration ────────────────────────────────────────
# Option 1: Path to service account JSON file (local development only)
#   NEVER commit this file to Git
FIREBASE_CREDENTIALS_JSON_PATH=

# Option 2: In Cloud Run, use individual env vars from Google Secret Manager
FIREBASE_PROJECT_ID=zhyra-e0d80
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Cloudflare R2 Storage (AWS S3 compatible) ───────────────────────────────
# Register at: https://dash.cloudflare.com → R2
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zhyra-ai-os-storage
# If missing, falls back to local folder: ./local_r2_storage/

# ─── Qdrant Vector Database ───────────────────────────────────────────────────
# Cloud Qdrant cluster URL
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=
# Fallback: in-memory when QDRANT_HOST is empty or connection fails

# ─── LLM Providers ────────────────────────────────────────────────────────────
# Configure at least ONE provider for the AI agents to work
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=

# ─── OAuth Integration Providers ─────────────────────────────────────────────
# Google OAuth (used for Calendar, Gmail, Drive, Meet)
# Register at: https://console.cloud.google.com/apis/credentials
# Enable: Calendar API, Gmail API, Drive API, People API
# Authorized redirect URI: https://zhyra.web.app/api/integrations/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://zhyra.web.app/api/integrations/oauth/callback/google

# Slack OAuth
# Register at: https://api.slack.com/apps
# Redirect URL: https://zhyra.web.app/api/integrations/oauth/callback/slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://zhyra.web.app/api/integrations/oauth/callback/slack

# Shopify OAuth (for multi-store support)
# Register at: https://partners.shopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://zhyra.web.app/api/integrations/oauth/callback/shopify

# HubSpot OAuth
# Register at: https://developers.hubspot.com
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://zhyra.web.app/api/integrations/oauth/callback/hubspot

# ─── API Key Integration Providers ───────────────────────────────────────────
# These are configured per-workspace via the Integrations UI, not here.
# Razorpay: key_id + key_secret entered by user in the Integrations page
# ElevenLabs: api_key entered by user in the Integrations page
# Google Maps: api_key entered by user in the Integrations page
# WhatsApp Business: access_token + phone_number_id entered by user

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_API_VERSION=v19.0
